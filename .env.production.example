# =========================================================================
# Variaveis de Ambiente para Implantacao do Ghost em Producao no Dokploy
# =========================================================================
#
# Para usar este arquivo:
# 1. Copie o conteudo abaixo ou adicione as variaveis diretamente no painel do Dokploy.
# 2. Substitua os valores de exemplo pelos seus valores reais de producao.
#
# =========================================================================

# -------------------------------------------------------------------------
# 1. Configurações Globais do Ghost
# -------------------------------------------------------------------------
# A URL publica do seu site Ghost. DEVE incluir o protocolo (http/https).
# IMPORTANTE: Se usar SSL no Dokploy (Traefik/Proxy do Dokploy), configure com https://
GHOST_URL=https://meudominio.com

# Desativa a verificação de novo dispositivo por email (2FA) para equipe.
# Altamente recomendado ao usar Cloudflare Tunnel, pois os IPs do Cloudflare mudam sempre
# e causariam loops de envio de 2FA constantes.
SECURITY_STAFF_DEVICE_VERIFICATION=false

# Define o ambiente como producao para desativar rotas de desenvolvimento e habilitar otimizacoes
NODE_ENV=production

# -------------------------------------------------------------------------
# 2. Configurações de Banco de Dados (MySQL 8)
# -------------------------------------------------------------------------
# Se voce estiver usando a "Option A" (MySQL gerenciado pelo Dokploy), preencha
# essas variaveis com as credenciais fornecidas pelo Dokploy ao criar o banco.
# Se estiver usando o "docker-compose.prod.yml", essas variaveis configuram
# tanto o container do MySQL quanto a conexao do Ghost com ele.
MYSQL_ROOT_PASSWORD=sua_senha_root_segura
DATABASE_NAME=ghost_production
DATABASE_USER=ghost
DATABASE_PASSWORD=sua_senha_do_usuario_ghost_segura

# Nota: Caso use banco externo ou gerenciado pelo Dokploy (Application mode), 
# voce precisara passar tambem a variavel de host (ex: host do banco no Dokploy):
# database__connection__host=mysql-dokploy-service-name

# -------------------------------------------------------------------------
# 3. Configurações de Envio de E-mail (SMTP)
# -------------------------------------------------------------------------
# Mude para "SMTP" para habilitar envio de emails reais (newsletters, convites, etc.)
MAIL_TRANSPORT=SMTP
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USER=postmaster@meudominio.com
MAIL_PASSWORD=sua_senha_smtp_do_provedor
MAIL_FROM=ola@obrinha.com

# -------------------------------------------------------------------------
# 4. Depuração e Debug no Dokploy (Opcional)
# -------------------------------------------------------------------------
# Define o nivel de detalhamento dos logs de producao (info, error, debug, warn)
GHOST_LOGGING_LEVEL=info

# Ativa mensagens de debug detalhadas diretamente nos logs do Dokploy
# Exemplo para debugar tudo do Ghost: DEBUG=ghost:*
# Exemplo para debugar somente autenticacao: DEBUG=ghost:auth:*
DEBUG=
